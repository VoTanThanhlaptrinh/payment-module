# Sao chép file này thành .env (đã được .gitignore) rồi điền giá trị thật. KHÔNG commit .env.
# Chỉ profile "local" đọc .env; staging/production đọc biến môi trường thật.

# ---------------------------------------------------------------------------
# payOS  (my.payos.vn > Kênh thanh toán > Cài đặt/Thông tin tích hợp)
# ---------------------------------------------------------------------------
PAYOS_ENABLED=false
# Ba khoá bí mật của kênh thanh toán. Không chia sẻ, không ghi log.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trình duyệt khách được payOS đưa về đây sau khi thanh toán xong / khi bấm huỷ (chỉ hiển thị, không đổi trạng thái). http(s) đều được.
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# Tuỳ chọn
PAYOS_PARTNER_CODE=
PAYOS_API_URL=https://api-merchant.payos.vn
PAYOS_EXPIRY_MINUTES=15
PAYOS_MIN_AMOUNT=2000
PAYOS_DESCRIPTION_PREFIX=DH
PAYOS_DESCRIPTION_MAX_LENGTH=9

# ---------------------------------------------------------------------------
# VNPay
# ---------------------------------------------------------------------------
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_VERSION=2.1.0
VNPAY_EXPIRY_MINUTES=15
VNPAY_RECONCILIATION_ENABLED=false
VNPAY_QUERY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_MERCHANT_IP=
